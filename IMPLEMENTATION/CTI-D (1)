import java.util.*;
import java.util.regex.*;
import java.awt.BorderLayout;
import java.awt.Button;
import java.awt.EventQueue;
import java.awt.FlowLayout;
import java.awt.Font;
import java.awt.Frame;
import java.awt.Panel;
import java.awt.TextArea;
import java.awt.event.WindowAdapter;
import java.awt.event.WindowEvent;

public class CtiDedup {

    record Report(String id, String provider, String text) {}

    enum Label { DUPLICATE, RELATED, UNRELATED }

    static final Pattern IP     = Pattern.compile("\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b");
    static final Pattern DOMAIN = Pattern.compile("\\b[a-z0-9-]+(?:\\.[a-z0-9-]+)*\\.(?:com|net|org|io|ru|cn|xyz|test)\\b");
    static final Pattern HASH   = Pattern.compile("\\b(?:[a-f0-9]{32}|[a-f0-9]{64})\\b");
    static final Pattern CVE    = Pattern.compile("\\bcve-\\d{4}-\\d{4,}\\b");

    // alias -> canonical name
    static final Map<String, String> ALIASES = new LinkedHashMap<>();
    static {
        ALIASES.put("apt28", "apt28");
        ALIASES.put("fancy bear", "apt28");
        ALIASES.put("sofacy", "apt28");
        ALIASES.put("lazarus", "lazarus group");
        ALIASES.put("hidden cobra", "lazarus group");
        ALIASES.put("emotet", "emotet");
        ALIASES.put("lockbit", "lockbit");
        ALIASES.put("cobalt strike", "cobalt strike");
    }

    // ---------- Normalization ----------

    static String norm(String s) {
        return s.toLowerCase(Locale.ROOT)
                .replace("[.]", ".")
                .replace("hxxp", "http")
                .replaceAll("\\s+", " ")
                .trim();
    }

    static Set<String> indicators(String text) {
        String s = norm(text);
        Set<String> out = new TreeSet<>();
        for (Pattern p : List.of(IP, DOMAIN, HASH, CVE)) {
            Matcher m = p.matcher(s);
            while (m.find()) out.add(m.group());
        }
        return out;
    }

    static Set<String> entities(String text) {
        String s = norm(text);
        Set<String> out = new TreeSet<>();
        for (Map.Entry<String, String> e : ALIASES.entrySet()) {
            if (Pattern.compile("\\b" + Pattern.quote(e.getKey()) + "\\b").matcher(s).find()) {
                out.add(e.getValue());
            }
        }
        return out;
    }

    static List<String> tokens(String text) {
        List<String> out = new ArrayList<>();
        for (String t : norm(text).replaceAll("[^a-z0-9.\\- ]", " ").split("\\s+")) {
            if (t.length() > 1) out.add(t);
        }
        return out;
    }

    // ---------- Scoring ----------

    static class Scorer {
        private final Map<String, Double> idf = new HashMap<>();

        Scorer(List<Report> corpus) {
            Map<String, Integer> df = new HashMap<>();
            for (Report r : corpus) {
                for (String t : new HashSet<>(tokens(r.text()))) df.merge(t, 1, Integer::sum);
            }
            int n = corpus.size();
            df.forEach((t, c) -> idf.put(t, Math.log((1.0 + n) / (1.0 + c)) + 1.0));
        }

        Map<String, Double> vector(String text) {
            Map<String, Double> v = new HashMap<>();
            for (String t : tokens(text)) v.merge(t, idf.getOrDefault(t, 1.0), Double::sum);
            return v;
        }

        record Result(double score, double tfidf, double indJaccard, double entJaccard, boolean conflict) {}

        Result compare(Report a, Report b) {
            double tfidf = cosine(vector(a.text()), vector(b.text()));
            double ind = jaccard(indicators(a.text()), indicators(b.text()));
            Set<String> ea = entities(a.text());
            Set<String> eb = entities(b.text());
            double ent = jaccard(ea, eb);
            boolean conflict = !ea.isEmpty() && !eb.isEmpty() && Collections.disjoint(ea, eb);
            double score = 0.4 * ind + 0.4 * tfidf + 0.2 * ent;
            return new Result(score, tfidf, ind, ent, conflict);
        }

        /**
         * Different named actors -> at most RELATED (shared infrastructure is not enough to merge).
         * DUPLICATE needs a high score plus strong text or indicator agreement.
         */
        Label classify(Result r) {
            if (r.conflict()) {
                return r.score() >= 0.2 ? Label.RELATED : Label.UNRELATED;
            }
            if (r.score() >= 0.6 && (r.tfidf() >= 0.5 || r.indJaccard() >= 0.6)) {
                return Label.DUPLICATE;
            }
            return r.score() >= 0.3 ? Label.RELATED : Label.UNRELATED;
        }
    }

    static double cosine(Map<String, Double> a, Map<String, Double> b) {
        double dot = 0, na = 0, nb = 0;
        for (Map.Entry<String, Double> e : a.entrySet()) {
            na += e.getValue() * e.getValue();
            Double o = b.get(e.getKey());
            if (o != null) dot += e.getValue() * o;
        }
        for (double v : b.values()) nb += v * v;
        return (na == 0 || nb == 0) ? 0.0 : dot / (Math.sqrt(na) * Math.sqrt(nb));
    }

    static double jaccard(Set<String> a, Set<String> b) {
        if (a.isEmpty() && b.isEmpty()) return 0.0;
        Set<String> inter = new HashSet<>(a);
        inter.retainAll(b);
        Set<String> union = new HashSet<>(a);
        union.addAll(b);
        return (double) inter.size() / union.size();
    }

    // ---------- Clustering (union-find) ----------

    static int find(int[] p, int x) {
        while (p[x] != x) {
            p[x] = p[p[x]];
            x = p[x];
        }
        return x;
    }

    // ---------- Demo data ----------

    static List<Report> sampleReports() {
        return List.of(
            new Report("A", "CERT-1",
                "APT28 phishing campaign delivered a backdoor. It beacons to update-cdn-sync.test on "
              + "198[.]51[.]100[.]23 and uses sample hash 9e107d9d372bb6826bd81d3542a419d6. Exploits CVE-2024-1234."),
            new Report("B", "CERT-2",
                "Fancy Bear phishing campaign delivered a backdoor. It beacons to update-cdn-sync.test on "
              + "198[.]51[.]100[.]23 and uses sample hash 9e107d9d372bb6826bd81d3542a419d6. Exploits CVE-2024-1234."),
            new Report("C", "CERT-3",
                "Lazarus reused infrastructure in a new intrusion. A custom loader calls back to "
              + "update-cdn-sync.test via 198[.]51[.]100[.]23 and drops a keylogger."),
            new Report("D", "CERT-4",
                "Emotet spam wave delivers a loader through malicious Word documents fetched from "
              + "mail-invoice-check.test and 203[.]0[.]113[.]50."),
            new Report("E", "CERT-5",
                "LockBit affiliate encrypts file servers after lateral movement. Ransom notes are dropped in each directory."));
    }

    // ---------- Main ----------

    public static void main(String[] args) {
        EventQueue.invokeLater(CtiDedup::showGui);
    }

    static void showGui() {
        Frame frame = new Frame("CTI Report Deduplicator");
        frame.setSize(760, 520);
        frame.setLayout(new BorderLayout(10, 10));
        frame.setLocationByPlatform(true);

        TextArea output = new TextArea();
        output.setEditable(false);
        output.setFont(new Font(Font.MONOSPACED, Font.PLAIN, 13));

        Panel controls = new Panel(new FlowLayout(FlowLayout.LEFT));
        Button runButton = new Button("Run Analysis");
        controls.add(runButton);

        frame.add(output, BorderLayout.CENTER);
        frame.add(controls, BorderLayout.NORTH);

        runButton.addActionListener(event -> output.setText(analyze()));
        frame.addWindowListener(new WindowAdapter() {
            @Override
            public void windowClosing(WindowEvent event) {
                frame.dispose();
            }
        });

        frame.setVisible(true);
        output.setText(analyze());
    }

    static String analyze() {
        List<Report> reports = sampleReports();
        Scorer scorer = new Scorer(reports);
        int n = reports.size();

        int[] parent = new int[n];
        for (int i = 0; i < n; i++) parent[i] = i;

        StringBuilder result = new StringBuilder();
        result.append("== Pairwise decisions ==\n");
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                Report a = reports.get(i), b = reports.get(j);
                Scorer.Result r = scorer.compare(a, b);
                Label label = scorer.classify(r);
                result.append(String.format("%s vs %s => %-9s score=%.3f  (tfidf=%.2f ind=%.2f ent=%.2f%s)%n",
                        a.id(), b.id(), label, r.score(), r.tfidf(), r.indJaccard(), r.entJaccard(),
                        r.conflict() ? " CONFLICT" : ""));
                if (label == Label.DUPLICATE) {
                    parent[find(parent, i)] = find(parent, j);
                }
            }
        }

        Map<Integer, List<String>> clusters = new LinkedHashMap<>();
        for (int i = 0; i < n; i++) {
            clusters.computeIfAbsent(find(parent, i), k -> new ArrayList<>()).add(reports.get(i).id());
        }

        result.append(String.format("%n== Clusters found: %d ==%n", clusters.size()));
        for (List<String> members : clusters.values()) {
            result.append("  ").append(members).append("\n");
        }
        return result.toString();
    }
}